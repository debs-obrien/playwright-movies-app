{
  "name": "tests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mock:build": "npm run build -w mock-api",
    "mock": "npm run start -w mock-api",
    "dev:app": "npm run dev -w movie-app",
    "dev": "npm run mock:build && concurrently -k -n mock,app -c blue,green \"npm run mock\" \"npm run dev:app\"",
    "build": "npm run build -w movie-app",
    "start": "npm run start -w movie-app",
    "lint": "tsc --noEmit && eslint tests/**/*.ts",
    "test": "playwright test",
    "format": "prettier --write tests/**/*",
    "postinstall": "npm run mock:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "workspaces": [
    "movies-app",
    "mock-api"
  ]
}
